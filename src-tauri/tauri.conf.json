{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StackHome",
  "version": "0.6.2",
  "identifier": "top.rowanjove.windows-easy-backup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StackHome · 归栈本地文件工作台",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "menuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      },
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "./wix/zh-CN.wxl"
          }
        }
      }
    }
  }
}
